// CraftRoni - Schemat bazy danych
// Polski sklep z rękodziełem

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// UŻYTKOWNICY I AUTORYZACJA
// ============================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String
  name            String?
  role            Role      @default(CUSTOMER)
  emailVerifiedAt DateTime?
  termsAcceptedAt DateTime?
  termsVersion    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  orders                  Order[]
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("sessions")
}

// Token resetu hasła — w bazie trzymany jako hash (jak sesje).
// Jednorazowy: po użyciu ustawiane jest usedAt.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @unique
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

enum Role {
  ADMIN
  CUSTOMER
}

// ============================================
// PRODUKTY I KATEGORIE
// ============================================

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  image       String?
  parentId    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@map("categories")
}

model Product {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?  @db.Text
  price        Decimal  @db.Decimal(10, 2)
  salePrice    Decimal? @db.Decimal(10, 2)
  sku          String?  @unique
  stock        Int      @default(0)
  stockVersion Int      @default(0)
  isActive     Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  categoryId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category   Category       @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  orderItems OrderItem[]

  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// ============================================
// ZAMÓWIENIA
// ============================================

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  userId      String?
  status      OrderStatus @default(PENDING)
  version     Int         @default(0)

  // Idempotencja checkoutu i czasowa rezerwacja magazynu
  checkoutKeyHash      String?   @unique
  checkoutRequestHash  String?
  reservationExpiresAt DateTime?
  stockReleasedAt      DateTime?

  // Dane klienta
  customerEmail String
  customerName  String
  customerPhone String?

  // Adres dostawy
  shippingAddress String @db.Text
  shippingCity    String
  shippingZip     String

  // Kwoty
  subtotal     Decimal @db.Decimal(10, 2)
  shippingCost Decimal @default(0) @db.Decimal(10, 2)
  total        Decimal @db.Decimal(10, 2)

  // Płatność
  paymentMethod         String?
  paymentId             String?
  paidAt                DateTime?
  paymentReviewRequired Boolean   @default(false)
  paymentReviewReason   String?

  // Dowód wersji regulaminu zaakceptowanej podczas checkoutu
  termsAcceptedAt DateTime?
  termsVersion    String?

  // Notatki
  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User?                @relation(fields: [userId], references: [id])
  items               OrderItem[]
  autopayTransactions AutopayTransaction[]
  paymentReviews      PaymentReviewCase[]
  statusEvents        OrderStatusEvent[]

  @@index([status, reservationExpiresAt])
  @@map("orders")
}

model AutopayTransaction {
  id                   String               @id @default(cuid())
  orderId              String
  serviceId            String               @db.VarChar(10)
  remoteId             String               @db.VarChar(20)
  amount               Decimal              @db.Decimal(10, 2)
  currency             String               @db.Char(3)
  status               AutopayPaymentStatus
  paymentDate          String               @db.Char(14)
  paymentStatusDetails String?              @db.VarChar(64)
  firstSeenAt          DateTime             @default(now())
  lastSeenAt           DateTime             @updatedAt

  order          Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentReviews PaymentReviewCase[]

  @@unique([serviceId, remoteId])
  @@index([orderId, status])
  @@map("autopay_transactions")
}

// Każdy nietypowy wpływ lub wymagany zwrot ma osobną sprawę. Nie przechowujemy
// rozstrzygnięcia wyłącznie na Order, ponieważ jedno zamówienie może mieć kilka
// niezależnych RemoteID i kilka otwartych spraw jednocześnie.
model PaymentReviewCase {
  id                   String    @id @default(cuid())
  orderId              String
  autopayTransactionId String?
  kind                 String
  dedupeKey            String    @unique
  remoteId             String?
  reason               String
  createdAt            DateTime  @default(now())
  resolvedAt           DateTime?
  resolvedBy           String?
  resolution           String?
  reference            String?

  order              Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  autopayTransaction AutopayTransaction? @relation(fields: [autopayTransactionId], references: [id], onDelete: Restrict)

  @@unique([autopayTransactionId, kind])
  @@index([orderId, resolvedAt])
  @@map("payment_review_cases")
}

enum AutopayPaymentStatus {
  PENDING
  SUCCESS
  FAILURE
}

model OrderStatusEvent {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorType  String
  actorId    String?
  reason     String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  name      String // Snapshot nazwy produktu

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

enum OrderStatus {
  PENDING // Oczekuje na płatność
  PAID // Opłacone
  PROCESSING // W realizacji
  SHIPPED // Wysłane
  DELIVERED // Dostarczone
  CANCELLED // Anulowane
}

// ============================================
// USTAWIENIA SKLEPU
// ============================================

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}
