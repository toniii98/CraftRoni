# Zmienne środowiskowe - SKOPIUJ DO .env I UZUPEŁNIJ
# NIE COMMITUJ PLIKU .env DO REPOZYTORIUM!

# ===========================================
# BAZA DANYCH
# ===========================================
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://username:password@localhost:3306/craftroni"

# ===========================================
# APLIKACJA
# ===========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===========================================
# AUTORYZACJA (WYMAGANE - aplikacja nie wystartuje bez tego)
# ===========================================
# Wygeneruj: openssl rand -base64 32
AUTH_SECRET=""

# Jednorazowo uzupełnij, uruchom `npm run admin:create`, a następnie usuń
# ADMIN_PASSWORD z właściwego pliku .env. Hasło musi mieć co najmniej 12 znaków.
ADMIN_EMAIL="admin@craftroni.pl"
ADMIN_NAME="Administrator"
ADMIN_PASSWORD=""

# ===========================================
# PŁATNOŚCI - AUTOPAY
# Dane z portalu https://portal.autopay.eu (testy: https://testportal.autopay.eu/admin)
# Gdy pola puste - płatności online są wyłączone (zamówienia czekają jako "Oczekujące").
# ===========================================
AUTOPAY_SERVICE_ID=""
AUTOPAY_SHARED_KEY=""
AUTOPAY_HASH_ALGORITHM="sha256"
AUTOPAY_SANDBOX="true"
# Opcjonalne: pozostaw puste, aby użyć https://testpay.autopay.eu lub https://pay.autopay.eu
AUTOPAY_GATEWAY_URL=""

# ===========================================
# EMAIL (SMTP) - powiadomienia o zamówieniach
# Gdy pola puste - e-maile nie są wysyłane (sklep działa dalej).
# ===========================================
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
