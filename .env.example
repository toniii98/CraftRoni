# Zmienne środowiskowe - SKOPIUJ DO .env I UZUPEŁNIJ
# NIE COMMITUJ PLIKU .env DO REPOZYTORIUM!

# ===========================================
# BAZA DANYCH
# ===========================================
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://username:password@localhost:3306/craftroni"

# ===========================================
# APLIKACJA
# ===========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ===========================================
# AUTORYZACJA (WYMAGANE - aplikacja nie wystartuje bez tego)
# ===========================================
# Wygeneruj: openssl rand -base64 32
AUTH_SECRET=""

# Konto administratora tworzone przez seed (npm run db:seed).
# Dev: puste ADMIN_PASSWORD = stałe hasło "admin123".
# Produkcja (NODE_ENV=production): ustaw własne; puste = losowe wypisane w konsoli.
ADMIN_EMAIL="admin@craftroni.pl"
ADMIN_PASSWORD=""

# ===========================================
# PŁATNOŚCI - PRZELEWY24
# Dane z panelu https://panel.przelewy24.pl (sandbox: https://sandbox.przelewy24.pl)
# Gdy pola puste - płatności online są wyłączone (zamówienia czekają jako "Oczekujące").
# ===========================================
P24_MERCHANT_ID=""
P24_POS_ID=""
P24_CRC=""
P24_API_KEY=""
P24_SANDBOX="true"

# ===========================================
# EMAIL (SMTP) - powiadomienia o zamówieniach
# Gdy pola puste - e-maile nie są wysyłane (sklep działa dalej).
# ===========================================
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
