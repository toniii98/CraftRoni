# Zmienne środowiskowe - SKOPIUJ DO .env I UZUPEŁNIJ
# NIE COMMITUJ PLIKU .env DO REPOZYTORIUM!

# ===========================================
# BAZA DANYCH
# ===========================================
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://username:password@localhost:3306/craftroni"

# ===========================================
# APLIKACJA
# ===========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Jawny typ środowiska: development, staging albo production.
APP_ENV="development"
# Produkcja przyjmuje zamówienia dopiero po ustawieniu true i pełnej konfiguracji Autopay.
CHECKOUT_ENABLED="false"
# NODE_ENV ustawia Next.js (`next dev` = development, `next build/start` = production).
# Nie zapisuj tej zmiennej na stałe w pliku środowiskowym.

# ===========================================
# AUTORYZACJA (WYMAGANE - aplikacja nie wystartuje bez tego)
# ===========================================
# Podpisuje wyłącznie sesje użytkowników.
# Wygeneruj co najmniej 32 losowe bajty, np.: openssl rand -base64 32
# Używaj innej wartości w dev, stagingu i produkcji. Rotacja wyloguje użytkowników.
AUTH_SECRET=""
# Osobny sekret HMAC dla tokenów wznowienia płatności; nie używaj AUTH_SECRET.
# Jest wymagany w produkcji także przy CHECKOUT_ENABLED=false. Wygeneruj niezależne
# co najmniej 32 losowe bajty dla każdego środowiska.
# Zaplanowana rotacja unieważnia aktywne linki i wymaga ich ponownego wydania.
PAYMENT_ACCESS_SECRET=""

# Jednorazowo uzupełnij, uruchom `npm run admin:create`, a następnie usuń
# ADMIN_PASSWORD z właściwego pliku .env. Hasło musi mieć co najmniej 12 znaków.
ADMIN_EMAIL="admin@craftroni.pl"
ADMIN_NAME="Administrator"
ADMIN_PASSWORD=""

# ===========================================
# PŁATNOŚCI - AUTOPAY
# Dane z portalu https://portal.autopay.eu (testy: https://testportal.autopay.eu/admin)
# Najpierw skonfiguruj i sprawdź sandbox. Dane produkcyjne muszą być odrębne.
# Gdy wymagane pola są puste, API odrzuca checkout i nie tworzy zamówienia.
# ===========================================
AUTOPAY_SERVICE_ID=""
AUTOPAY_SHARED_KEY=""
AUTOPAY_HASH_ALGORITHM="sha256"
AUTOPAY_SANDBOX="true"
# Opcjonalne: pozostaw puste, aby użyć https://testpay.autopay.eu lub https://pay.autopay.eu
AUTOPAY_GATEWAY_URL=""

# ===========================================
# EMAIL (SMTP) - powiadomienia o zamówieniach
# Gdy pola są puste, e-maile nie są wysyłane; rejestracja konta jest niedostępna,
# a reset hasła nie dostarczy linku. Dane SMTP dla środowisk trzymaj osobno.
# ===========================================
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
